<script>
    $(function(){
	   
		$("#UserLoginForm").submit(function(e) {
		
			t = $("#pubkey").val(),
			a = forge.pki.publicKeyFromPem(t),
			r = $("#UserPassword").val(),
			i = a.encrypt(r),
			s = forge.util.encode64(i);
			
		$("#UserPassword").val(s);
	
	})
 })	
</script>


        <script type="text/javascript">

