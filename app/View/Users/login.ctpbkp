<script type="text/javascript">
$(document).ready(function(){
	
	 $('#reload').click(function() {
          var captcha = $("#captcha_image");
           captcha.attr('src', captcha.attr('src')+'?'+Math.random());
		   $('#UserPassword').val('');
		   $('#UserCaptcha').val('');
          return false;
      });
	  
      
      $('#UserLoginForm').submit(function(){
          
         $('#loginModelBody').append('<div class="overlay"><i class="fa fa-refresh fa-spin"></i></div>'); 
       $.post(
                  '<?php echo $this->webroot;?>users/login',
                    
                        $(this).serialize()
                    ,
                    //function(response)
                   // {
                     //   if(response=='refresh')
						
                            //location.reload();
			//				window.location.href='<?php echo $this->webroot;?>dashboard';
                        // else
                        // $('#loginModelBody').html(response);
                    // }
			function(response) {
	if (response === 'refresh') {
		window.location.href = '<?php echo $this->webroot; ?>dashboard';
	} else if (response === 'refreshf') {
		window.location.href = '<?php echo $this->webroot; ?>users/change_password';
	} else {
		$('#login-block').html(response);
	}
}
          );
          return false;
          
      });
	
});
</script>
